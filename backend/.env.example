# Copy to .env and fill in. .env is git-ignored.

# --- Django ---
SECRET_KEY=generate-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL + PostGIS) ---
DB_NAME=energy_resilience
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
# Or, instead of the DB_* vars above, a single URL:
# DATABASE_URL=postgis://postgres:your_password_here@localhost:5432/energy_resilience

# --- Native geospatial libraries (Windows venv: point at the GDAL wheel's DLLs) ---
# GDAL_LIBRARY_PATH=C:/Joshua/energy-resilience/venv/Lib/site-packages/osgeo/gdal.dll
# GEOS_LIBRARY_PATH=C:/Joshua/energy-resilience/venv/Lib/site-packages/osgeo/geos_c.dll
# PROJ_LIB=C:/Joshua/energy-resilience/venv/Lib/site-packages/osgeo/data/proj

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
# LLM extraction goes through OpenRouter (OpenAI-compatible wire protocol, so
# the openai SDK is used with a swapped base_url). Key from openrouter.ai/keys.
OPENROUTER_API_KEY=
# Everything below has a working default in settings.py — override only to
# switch model or provider (e.g. LLM_BASE_URL=https://api.openai.com/v1
# with LLM_MODEL=gpt-4o-mini and an sk-... key, to go direct to OpenAI).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=deepseek/deepseek-v4-flash-0731
# LLM_MAX_TOKENS=500
# Reasoning tokens are billed as output and share the max-token budget, so a
# long think can truncate the JSON. Leave off for extraction.
# LLM_REASONING=False
EIA_API_KEY=

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
