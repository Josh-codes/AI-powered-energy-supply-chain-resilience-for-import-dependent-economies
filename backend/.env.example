# Copy to .env and fill in. .env is git-ignored.

# --- Django ---
SECRET_KEY=generate-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Leave unset to use SQLite (backend/db.sqlite3) for early local dev.
# For the real stack, install PostgreSQL + PostGIS + GDAL, enable
# "django.contrib.gis" in settings, and set:
# DATABASE_URL=postgis://postgres:your_password@localhost:5432/energy_resilience

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
OPENAI_API_KEY=
EIA_API_KEY=

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
