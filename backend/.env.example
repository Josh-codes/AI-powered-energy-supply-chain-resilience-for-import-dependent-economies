# Copy to .env and fill in. .env is git-ignored.

# --- Django ---
SECRET_KEY=generate-a-long-random-string-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL + PostGIS) ---
DB_NAME=energy_resilience
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
# Or, instead of the DB_* vars above, a single URL:
# DATABASE_URL=postgis://postgres:your_password_here@localhost:5432/energy_resilience

# --- Native geospatial libraries (Windows venv: point at the GDAL wheel's DLLs) ---
# GDAL_LIBRARY_PATH=C:/Joshua/energy-resilience/venv/Lib/site-packages/osgeo/gdal.dll
# GEOS_LIBRARY_PATH=C:/Joshua/energy-resilience/venv/Lib/site-packages/osgeo/geos_c.dll
# PROJ_LIB=C:/Joshua/energy-resilience/venv/Lib/site-packages/osgeo/data/proj

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- External APIs ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
EIA_API_KEY=

# --- CORS (frontend origin) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
